# OpenAI or OpenRouter or LM Studio
OPENAI_API_KEY=your_api_key_here

# Optional: override base URL (e.g., for OpenRouter or local LM Studio)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:1234/v1

# Optional: model name (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: route ALL messages through LLM with tool execution loop.
# When false (default), common banking keywords use instant regex shortcuts for demos.
# Set to true when using a local model like LM Studio.
# USE_LLM_FOR_ALL=false
